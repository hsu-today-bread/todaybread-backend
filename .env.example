# MYSQL DATABASE 
MYSQL_DATABASE=todaybread
MYSQL_USER=todaybread
MYSQL_PASSWORD=todaybread
MYSQL_ROOT_PASSWORD=rootpassword

# JWT SECRET KEY
# openssl rand -base64 32 can be worked for this.
JWT_SECRET=your-production-secret-key-at-least-32-bytes-long-change-this

# Toss Payments API Keys
# TEST MODE: prefix test_sk
# LIVE MODE: prefix live_sk
TOSS_SECRET_KEY=test_sk_your_secret_key_here
TOSS_CLIENT_KEY=test_ck_your_client_key_here

# Firebase Cloud Messaging
# Keep false unless you have a Firebase Admin SDK service account JSON.
# GOOGLE_APPLICATION_CREDENTIALS must be an absolute path to the JSON file.
FCM_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk-service-account.json

# National Tax Service API KEY
NTS_BUSINESS_SERVICE_KEY=your_own_service_key