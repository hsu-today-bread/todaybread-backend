# ===========================
# Spring Profile
# ===========================
SPRING_PROFILES_ACTIVE=local

# ===========================
# MySQL
# ===========================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=todaybread
MYSQL_USER=todaybread
MYSQL_PASSWORD=todaybread
MYSQL_ROOT_PASSWORD=rootpassword

# ===========================
# File Upload
# ===========================
UPLOAD_DIR=./uploads

# ===========================
# JWT
# ===========================
JWT_SECRET=replace-with-local-64-hex-secret

# ===========================
# Toss Payments
# ===========================
TOSS_SECRET_KEY=test_sk_your_secret_key_here
TOSS_CLIENT_KEY=test_ck_your_client_key_here

# ===========================
# FCM Push Notification
# ===========================
FCM_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json

# ===========================
# NTS Service
# ===========================
NTS_BUSINESS_SERVICE_KEY=your_own_service_key

# ===========================
# Business Approval
# ===========================
BUSINESS_APPROVAL_HASH_SECRET=replace-with-local-64-hex-secret
